# ==============================================================================
# Aegis Sentinel Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Spring Profile & Server Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL on port 5433 for local dev)
# ------------------------------------------------------------------------------
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/aegis
SPRING_DATASOURCE_USERNAME=aegis
SPRING_DATASOURCE_PASSWORD=aegis_dev

# ------------------------------------------------------------------------------
# 3. Redis Cache & Rate Limiting (Redis on port 6380 for local dev)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# ------------------------------------------------------------------------------
# 4. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Base64-encoded or raw HMAC-SHA256 key (minimum 32 bytes)
AEGIS_JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLWRldmVsb3BtZW50LWp3dC1zZWNyZXQta2V5LTMyLWJ5dGVzLW1pbg==
AEGIS_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://aegissentinal.sushantkumaryadav.com.np

# OAuth2 Google Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. AI Detection & Oracle Copilot Reasoning (Gemini & OpenAI)
# ------------------------------------------------------------------------------
# Supply your Google Gemini API key (recommended: gemini-2.5-flash / gemini-1.5-flash)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional fallback: OpenAI API key (gpt-4o-mini / gpt-4o)
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=
