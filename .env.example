# Aegis Sentinel Environment Variables Example Template
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AEGIS_JWT_SECRET=your-jwt-secret-key-at-least-32-bytes-long
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/aegis
SPRING_DATASOURCE_USERNAME=aegis
SPRING_DATASOURCE_PASSWORD=aegis_dev
# AI Models (Gemini / OpenAI for Sentinel Core Log Analysis and Oracle Security Copilot)
GEMINI_API_KEY=
OPENAI_API_KEY=
